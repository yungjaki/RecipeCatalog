@model (double Average, int Count)
@{
    var rounded = (int)Math.Round(Model.Average, MidpointRounding.AwayFromZero);
}
<span class="stars" aria-label="Рейтинг @Model.Average.ToString("0.0") от 5">
    @for (var i = 1; i <= 5; i++)
    {
        <span class="star @(i <= rounded ? "on" : "")" aria-hidden="true">★</span>
    }
    <span class="stars-text">
        @if (Model.Count > 0)
        {
            @Model.Average.ToString("0.0")<small> (@Model.Count)</small>
        }
        else
        {
            <small>без оценки</small>
        }
    </span>
</span>
